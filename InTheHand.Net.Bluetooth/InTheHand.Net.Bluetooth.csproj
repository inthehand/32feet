<Project Sdk="Microsoft.NET.Sdk">
	<Sdk Name="DotNet.ReproducibleBuilds.Isolated" Version="2.0.5" />
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net9.0;net9.0-windows7.0;net9.0-windows10.0.19041.0;net9.0-android;net9.0-ios;net10.0;net10.0-android;net10.0-ios;net462</TargetFrameworks>
		<Company>In The Hand Ltd</Company>
		<Authors>Peter Foot</Authors>
		<Product>32feet.NET</Product>
		<Version>4.2.5</Version>
		<RepositoryUrl>https://github.com/inthehand/32feet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Nullable>disable</Nullable>
		<CheckEolWorkloads>false</CheckEolWorkloads>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageProjectUrl>https://github.com/inthehand/32feet</PackageProjectUrl>
		<PackageLicenseUrl></PackageLicenseUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Copyright>Copyright (c) 2004-2026 In The Hand Ltd</Copyright>
		<Description>32feet.NET is an open-source project to make personal area networking technologies such as Bluetooth easily accessible from .NET code.</Description>
		<FileVersion>4.2.5.0</FileVersion>
		<AssemblyVersion>4.2.5.0</AssemblyVersion>
		<AssemblyName>InTheHand.Net.Bluetooth</AssemblyName>
		<AssemblyTitle>InTheHand.Net.Bluetooth-$(TargetFramework)</AssemblyTitle>
		<GenerateDocumentationFile Condition=" '$(Configuration)' == 'Release' ">true</GenerateDocumentationFile>
		<PackageTags>bluetooth windows win32 android iOS linux</PackageTags>
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
		<GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageId>InTheHand.Net.Bluetooth</PackageId>
		<PackageReleaseNotes>Legacy platforms removed.</PackageReleaseNotes>
		<PackageIcon>32feet-package-icon.png</PackageIcon>
		<SignAssembly Condition=" '$(Configuration)' == 'Release' ">true</SignAssembly>
		<AssemblyOriginatorKeyFile Condition=" '$(Configuration)' == 'Release' ">InTheHand.snk</AssemblyOriginatorKeyFile>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" PrivateAssets="All" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="Platforms\**\*.*" />
		<None Include="..\Misc\32feet-package-icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="Platforms\**\*.*" />
		<None Include="README.md" Pack="true" PackagePath="\"/>
	</ItemGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0-windows10.0.19041.0' ">
		<DefineConstants>WinRT</DefineConstants>
		<SupportedOSPlatformVersion>10.0.16299.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.16299.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0-windows10.0.19041.0' ">
		<DefineConstants>WinRT</DefineConstants>
		<SupportedOSPlatformVersion>10.0.16299.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.16299.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net462' ">
		<Compile Include="Platforms\Win32\*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
		<PackageReference Include="Tmds.DBus" Version="0.95.1" />
		<PackageReference Include="Linux.Bluetooth" Version="5.67.1" />
		<Compile Include="Platforms\Linux\*.cs" />
		<Compile Include="Platforms\Win32\*.cs" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
		<PackageReference Include="Tmds.DBus" Version="0.95.1" />
		<PackageReference Include="Linux.Bluetooth" Version="5.67.1" />
		<Compile Include="Platforms\Linux\*.cs" />
		<Compile Include="Platforms\Win32\*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-windows7.0' ">
		<Compile Include="Platforms\Win32\*.cs" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-windows10.0.19041.0' ">
		<Compile Include="Platforms\Windows\*.cs" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0-windows7.0' ">
		<Compile Include="Platforms\Win32\*.cs" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0-windows10.0.22621.0' ">
		<Compile Include="Platforms\Windows\*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-android' ">
		<PackageReference Include="InTheHand.AndroidActivity" Version="1.0.5" />
		<Compile Include="Platforms\Android\*.cs" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0-android' ">
		<PackageReference Include="InTheHand.AndroidActivity" Version="1.0.5" />
		<Compile Include="Platforms\Android\*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-ios' ">
		<Compile Include="Platforms\iOS\*.cs" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0-ios' ">
		<Compile Include="Platforms\iOS\*.cs" />
	</ItemGroup>
</Project>
